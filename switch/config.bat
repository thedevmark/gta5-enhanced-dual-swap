@echo off
REM ============================================================
REM  GTA V Enhanced dual-install switch - CONFIG
REM
REM  Set GTA_BASE to your Steam library "common" folder,
REM  i.e. the folder that CONTAINS "Grand Theft Auto V Enhanced".
REM
REM  Example:  D:\SteamLibrary\steamapps\common
REM  Default Steam path: C:\Program Files (x86)\Steam\steamapps\common
REM
REM  If you leave it blank or wrong, the switch scripts will try
REM  to auto-detect common Steam library locations.
REM ============================================================
set "GTA_BASE=D:\SteamLibrary\steamapps\common"
